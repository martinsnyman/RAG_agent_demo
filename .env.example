# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your real keys never get committed.

# Required: used for embeddings and answer generation
OPENAI_API_KEY=your-openai-key-here

# Optional: only needed if you enable Tavily web search in the UI
TAVILY_API_KEY=your-tavily-key-here

# Optional: only needed if you enable "Email Answer" in the UI
RESEND_API_KEY=your-resend-key-here

# Chat model used for the final answer
MODEL=gpt-5

# Path to the PDF to index (defaults to data/tax_guide.pdf)
PDF_PATH=data/tax_guide.pdf
